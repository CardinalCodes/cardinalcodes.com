---
import { ossProjects } from '../data/oss';
---
<!-- ============ OPEN SOURCE ============ -->
<section id="open-source" class="oss" aria-labelledby="ossTitle" style="background:color-mix(in srgb,var(--sunken) 55%,var(--bg));border-bottom:1px solid var(--line)">
  <div class="container">

    <div class="sec-head" data-reveal>
      <div>
        <p class="kicker" data-en="// Public research &amp; software" data-fr="// Recherche &amp; logiciels publics">// Public research &amp; software</p>
        <h2 class="sec-title" id="ossTitle" data-en="Open source initiatives." data-fr="Engagements open source.">Open source initiatives.</h2>
      </div>
      <p class="lede" data-en="Our commitment to transparent code, open standards and privacy-preserving protocols." data-fr="Notre engagement pour un code transparent, des standards ouverts et des protocoles respectueux de la vie privée.">
        Our commitment to transparent code, open standards and privacy-preserving protocols.
      </p>
    </div>

    <div class="grid-3">
      {ossProjects.map((p, i) => (
        <a class={`card card-glow oss-card${p.muted ? ' muted' : ''}`} href={p.url} target="_blank" rel="noopener noreferrer" data-reveal style={i ? `--d:${i / 10}s` : undefined}>
          <div class="oss-top">
            <h3>{p.name}</h3>
            <span class={`tag${p.tag.variant ? ` tag-${p.tag.variant}` : ''}`} data-en={p.tag.en} data-fr={p.tag.fr}>{p.tag.en}</span>
          </div>
          <p data-en={p.text.en} data-fr={p.text.fr}>{p.text.en}</p>
          <span class="oss-link">
            <span data-en={p.linkLabel.en} data-fr={p.linkLabel.fr}>{p.linkLabel.en}</span>
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </span>
        </a>
      ))}
    </div>

  </div>
</section>

<style is:global>
/* ---------- Open source ---------- */
.oss .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:1.3rem}
.oss-card{padding:1.7rem 1.6rem;display:flex;flex-direction:column;gap:1rem}
.oss-top{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem}
.oss-top h3{font-size:1.2rem}
.oss-card p{font-size:.82rem;color:var(--ink-2);line-height:1.65;flex:1}
.oss-link{
  display:flex;justify-content:space-between;align-items:center;gap:1rem;
  padding-top:1rem;border-top:1px solid var(--line);
  font-family:var(--font-mono);font-size:.68rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  color:var(--carmin-ink);transition:color .25s;
}
.oss-link svg{width:.9rem;height:.9rem;transition:transform .25s var(--ease-out)}
.oss-card:hover .oss-link svg{transform:translate(2px,-2px)}
.oss-card.muted .oss-link{color:var(--ink-3)}
.oss-card.muted:hover .oss-link{color:var(--ink-2)}

@media (max-width:860px){
  .oss .grid-3{grid-template-columns:1fr}
}
</style>
